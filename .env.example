# Banco de dados (SQLite em desenvolvimento; use postgresql://... em produção e troque o provider no schema.prisma)
DATABASE_URL="file:./dev.db"

# Primeiro administrador (usado apenas pelo seed, se o e-mail ainda não existir)
SEED_ADMIN_EMAIL="admin@digitusul.local"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Administrador"

# Diretório privado de arquivos enviados (fora de /public)
STORAGE_DIR="storage"

# URL pública da aplicação (links de redefinição de senha)
APP_URL="http://localhost:3000"

# ── Integrações opcionais (chaves ficam somente no servidor) ──
# IA (Anthropic Claude): habilita "Criar com IA", leitura de imagens e busca inteligente no catálogo
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5-5"
# Remoção de fundo (remove.bg)
REMOVE_BG_API_KEY=""

# Catálogo do site Digitusul (índice de busca público do e-commerce)
CATALOG_ALGOLIA_APP_ID="91279IH7HY"
CATALOG_ALGOLIA_INDEX="produtos_digitusul"
CATALOG_SITE_URL="https://www.digitusul.com.br"
CATALOG_MIN_STOCK="2"
CATALOG_IMAGE_HOSTS="www.digitusul.com.br,digitusul.com.br,cdn.noxcommerce.com.br"
