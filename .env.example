# ── Banco de dados (PostgreSQL — ex.: Neon, plano gratuito) ──
# Na Vercel, a integração Neon preenche estas duas variáveis automaticamente.
DATABASE_URL="postgresql://usuario:senha@host-pooler.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require"

# ── Primeiro administrador (criado pelo seed apenas se o e-mail ainda não existir) ──
SEED_ADMIN_EMAIL="admin@digitusul.local"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Administrador"

# ── Armazenamento de arquivos ──
# Na Vercel: conecte um Blob Store ao projeto (preenche BLOB_READ_WRITE_TOKEN).
# Sem o token, os arquivos vão para o disco local (somente desenvolvimento).
BLOB_READ_WRITE_TOKEN=""
STORAGE_DIR="storage"

# URL pública (links de redefinição de senha). Na Vercel é detectada automaticamente.
APP_URL="http://localhost:3000"

# ── Integrações opcionais (chaves ficam somente no servidor) ──
# IA (Anthropic Claude): "Criar com IA", leitura de imagens e busca inteligente no catálogo
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5-5"
# Remoção de fundo (remove.bg)
REMOVE_BG_API_KEY=""

# Catálogo do site Digitusul (índice de busca público do e-commerce)
CATALOG_ALGOLIA_APP_ID="91279IH7HY"
CATALOG_ALGOLIA_INDEX="produtos_digitusul"
CATALOG_SITE_URL="https://www.digitusul.com.br"
CATALOG_MIN_STOCK="2"
CATALOG_IMAGE_HOSTS="www.digitusul.com.br,digitusul.com.br,cdn.noxcommerce.com.br"
