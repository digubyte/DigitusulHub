{
  "name": "digitusul-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Digitusul Hub — plataforma interna modular (núcleo + Estúdio de Flyers)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "prisma migrate deploy && tsx prisma/seed.ts",
    "vercel-build": "node scripts/vercel-build.mjs",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@prisma/client": "6.19.3",
    "@vercel/blob": "^1.1.1",
    "bcryptjs": "3.0.2",
    "jspdf": "3.0.3",
    "konva": "9.3.22",
    "lucide-react": "0.468.0",
    "next": "15.5.29",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-konva": "19.0.10",
    "server-only": "^0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "3.2.7"
  },
  "overrides": {
    "esbuild": "0.25.12"
  },
  "allowScripts": {
    "@prisma/engines@6.19.3": true,
    "esbuild@0.25.12": true,
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true
  },
  "engines": {
    "node": ">=20"
  }
}
